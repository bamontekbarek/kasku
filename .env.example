# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# Hanya server: upload foto struk, status scan, kuota (dan nanti hapus akun). Jangan pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# M3 · scan struk (PRD 7)
DEEPSEEK_API_KEY=
AI_RECEIPT_MODEL=deepseek-flash
# Opsional
# AI_BASE_URL=https://api.deepseek.com
# AI_IMAGE_DETAIL=original          # low | high | original (lihat uji varian di PRD 7.1)

# Kuota scan (PRD 7.2), semua opsional; nilai di bawah = default
# SCAN_DAILY_LIMIT=20
# SCAN_PER_MINUTE=3
# SCAN_IP_HOURLY=30
# SCAN_MAX_BYTES=2097152
# Batas biaya AI harian semua user (USD). Kosong = tanpa batas.
# AI_DAILY_COST_LIMIT_USD=2
# Harga per 1 juta token (deepseek-flash, tarif peak Nov 2026)
# AI_PRICE_INPUT_PER_M=0.3
# AI_PRICE_CACHED_PER_M=0.006
# AI_PRICE_OUTPUT_PER_M=1.2
