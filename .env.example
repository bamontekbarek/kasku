# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# Hanya server (belum dipakai di M1; dibutuhkan untuk hapus akun dan scan)
SUPABASE_SERVICE_ROLE_KEY=

# M3 · scan struk
DEEPSEEK_API_KEY=
AI_RECEIPT_MODEL=deepseek-flash
